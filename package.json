{
  "name": "sortify-api",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "build": "bun build index.ts --outdir ./dist --target node",
    "lint": "eslint \"**/*.{js,ts}\"",
    "lint:fix": "eslint \"**/*.{js,ts}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "bun --no-install tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "ci": "bun run lint && bun run format:check && bun run type-check && bun run test && bun run build",
    "ci:fix": "bun run lint:fix && bun run format && bun run type-check && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "^8.57.1",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "prettier": "^3.0.0",
    "eslint-config-prettier": "^9.0.0"
  },
  "dependencies": {
    "hono": "latest",
    "spotify-web-api-node": "latest",
    "dotenv": "^16.3.1"
  }
}
